rules_version = '2';

// Reglas de Cloud Firestore para El Club del Frijol.
//
// config/app            → configuración (la app la crea con todo en true si no
//                         existe; solo se edita desde la consola):
//     peliculas: bool        lista de películas visible
//     deseos: bool           lista de deseos visible
//     planes: bool           lista "Hacer juntos" visible
//     registroAbierto: bool  si alguien nuevo puede unirse al club
//     calificaciones, autores, ruleta, buscar, fotos, posters, contador,
//     widget, actualizaciones: bool   funciones de la app (fotos también
//                         se aplica aquí)
//     aniversario: timestamp  fecha del contador (opcional)
//   Si el documento o un campo booleano no existe, vale true.
//
// categorias/{lista}    → categorías de cada lista: campo `nombres` (arreglo).
//
// usuarios/{uid}        → miembros del club (se crean al entrar con Google
//                         mientras el registro está abierto).
//
// clubs/{clubId}        → club; la app lo crea la primera vez junto con los
//                         datos iniciales de las listas.
// clubs/{clubId}/{lista}/{itemId} → elementos de las listas (creadoPor,
//                         hechoPor, calificaciones.{uid}, pelicula, fotos).
// clubs/{clubId}/{lista}/{itemId}/fotos/{fotoId} → fotos (campo datos: bytes).
// config/tmdb           → apiKey de TMDB (solo miembros la leen).
// clubs/{clubId}/cartas/{id} (+ contenido/texto) → cartas con fecha.
// clubs/{clubId}/fechas/{id}  → fechas importantes.
// clubs/{clubId}/preguntas/{aaaa-mm-dd} (+ respuestas/{uid}) → pregunta del día.
// config/version        → última versión publicada (la escribe GitHub Actions
//                         con una cuenta de servicio; la app solo la lee).
// apk/{build}/partes/{n} → el APK partido en trozos (campo datos: bytes).
service cloud.firestore {
  match /databases/{database}/documents {

    function conGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function config() {
      let ruta = /databases/$(database)/documents/config/app;
      return exists(ruta) ? get(ruta).data : {};
    }

    function esMiembro() {
      return conGoogle()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function banderas() {
      return ['peliculas', 'deseos', 'planes', 'registroAbierto',
              'calificaciones', 'autores', 'ruleta', 'buscar', 'fotos',
              'posters', 'contador', 'widget', 'actualizaciones', 'cartas',
              'resumen', 'fechas', 'preguntas', 'sugerencias', 'repetibles',
              'preguntasInternet'];
    }

    // Cada bandera que no existía en [antes] debe agregarse en true.
    function nuevaEnTrue(antes, k) {
      return k in antes || request.resource.data.get(k, true) == true;
    }

    function soloAgregaBanderasEnTrue(antes) {
      return nuevaEnTrue(antes, 'peliculas') && nuevaEnTrue(antes, 'deseos')
        && nuevaEnTrue(antes, 'planes') && nuevaEnTrue(antes, 'registroAbierto')
        && nuevaEnTrue(antes, 'calificaciones') && nuevaEnTrue(antes, 'autores')
        && nuevaEnTrue(antes, 'ruleta') && nuevaEnTrue(antes, 'buscar')
        && nuevaEnTrue(antes, 'fotos') && nuevaEnTrue(antes, 'posters')
        && nuevaEnTrue(antes, 'contador') && nuevaEnTrue(antes, 'widget')
        && nuevaEnTrue(antes, 'actualizaciones') && nuevaEnTrue(antes, 'cartas')
        && nuevaEnTrue(antes, 'resumen') && nuevaEnTrue(antes, 'fechas')
        && nuevaEnTrue(antes, 'preguntas') && nuevaEnTrue(antes, 'sugerencias')
        && nuevaEnTrue(antes, 'repetibles')
        && nuevaEnTrue(antes, 'preguntasInternet');
    }

    function listaVisible(lista) {
      return lista in ['peliculas', 'deseos', 'planes']
        && config().get(lista, true) == true;
    }

    // Clave de TMDB (pósters de películas): la leen los miembros; se escribe
    // desde la consola (config/tmdb, campo apiKey).
    match /config/tmdb {
      allow read: if esMiembro();
      allow write: if false;
    }

    // Configuración: cualquiera con sesión la lee. La app solo puede crearla
    // (si no existe) con los valores por defecto; cambiarla, solo en la consola.
    match /config/{doc} {
      allow read: if conGoogle() && doc != 'tmdb';
      // La app crea el documento con todas las banderas en true...
      allow create: if esMiembro()
        && doc == 'app'
        && request.resource.data.keys().hasOnly(banderas())
        && soloAgregaBanderasEnTrue({});
      // ...o agrega las que falten (en true), sin cambiar ninguna existente.
      allow update: if esMiembro()
        && doc == 'app'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(banderas())
        && request.resource.data.diff(resource.data).changedKeys().size() == 0
        && request.resource.data.diff(resource.data).removedKeys().size() == 0
        && soloAgregaBanderasEnTrue(resource.data);
      allow delete: if false;
    }

    // Categorías de cada lista: categorias/{peliculas|deseos|planes} con el
    // campo `nombres` (arreglo de textos, en orden). La app las crea la
    // primera vez; se editan desde la consola.
    match /categorias/{lista} {
      allow read: if conGoogle();
      allow create: if esMiembro()
        && lista in ['peliculas', 'deseos', 'planes']
        && request.resource.data.keys().hasOnly(['nombres'])
        && request.resource.data.nombres is list
        && request.resource.data.nombres.size() > 0
        && request.resource.data.nombres.size() <= 50;
      allow update, delete: if false;
    }

    // APK de cada versión, partido en documentos de < 1 MB (lo sube GitHub
    // Actions con una cuenta de servicio). Solo los miembros lo descargan.
    match /apk/{build} {
      allow read: if esMiembro();
      allow write: if false;
      match /partes/{parte} {
        allow read: if esMiembro();
        allow write: if false;
      }
    }

    function activa(bandera) {
      return config().get(bandera, true) == true;
    }

    // 💌 Cartas con fecha. El documento tiene los datos visibles (de, titulo,
    // abrirEn, creadaEn, abiertaEn); el texto vive aparte en
    // contenido/texto y solo se puede leer desde abrirEn (o si eres el autor).
    match /clubs/{clubId}/cartas/{cartaId} {
      function carta() {
        return get(/databases/$(database)/documents/clubs/$(clubId)/cartas/$(cartaId)).data;
      }
      allow read: if esMiembro() && activa('cartas');
      allow create: if esMiembro() && activa('cartas')
        && request.resource.data.de.uid == request.auth.uid
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 120
        && request.resource.data.abrirEn is timestamp;
      // Al abrirla solo se marca abiertaEn (no se cambia nada más).
      allow update: if esMiembro() && activa('cartas')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['abiertaEn', 'abiertaPor'])
        && request.time >= resource.data.abrirEn;
      allow delete: if esMiembro() && resource.data.de.uid == request.auth.uid;

      match /contenido/{doc} {
        allow read: if esMiembro() && activa('cartas')
          && (carta().de.uid == request.auth.uid
              || request.time >= carta().abrirEn);
        allow create: if esMiembro() && activa('cartas')
          && getAfter(/databases/$(database)/documents/clubs/$(clubId)/cartas/$(cartaId)).data.de.uid == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() <= 5000;
        allow update: if false;
        allow delete: if esMiembro() && carta().de.uid == request.auth.uid;
      }
    }

    // 🎲 Preguntas propuestas por el club. Cualquiera propone; al usarse como
    // pregunta del día solo se marca usadaEn; el autor puede borrarla.
    match /clubs/{clubId}/banco_preguntas/{id} {
      allow read: if esMiembro() && activa('preguntas');
      allow create: if esMiembro() && activa('preguntas')
        && request.resource.data.keys().hasOnly(['texto', 'autor', 'creadaEn'])
        && request.resource.data.autor.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() >= 5
        && request.resource.data.texto.size() <= 300;
      allow update: if esMiembro() && activa('preguntas')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usadaEn'])
        && !('usadaEn' in resource.data);
      allow delete: if esMiembro() && resource.data.autor.uid == request.auth.uid;
    }

    // 📆 Fechas importantes.
    match /clubs/{clubId}/fechas/{fechaId} {
      allow read, delete: if esMiembro() && activa('fechas');
      allow create, update: if esMiembro() && activa('fechas')
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 80
        && request.resource.data.fecha is timestamp;
    }

    // 🎲 Pregunta del día: preguntas/{aaaa-mm-dd} con la pregunta, y cada
    // respuesta en respuestas/{uid}. La respuesta del otro solo se puede leer
    // después de contestar la tuya.
    match /clubs/{clubId}/preguntas/{dia} {
      allow read: if esMiembro() && activa('preguntas');
      allow create: if esMiembro() && activa('preguntas')
        && request.resource.data.pregunta is string
        && request.resource.data.pregunta.size() <= 300;
      allow update, delete: if false;

      match /respuestas/{uid} {
        allow read: if esMiembro() && activa('preguntas')
          && (uid == request.auth.uid
              || exists(/databases/$(database)/documents/clubs/$(clubId)/preguntas/$(dia)/respuestas/$(request.auth.uid)));
        allow create, update: if esMiembro() && activa('preguntas')
          && uid == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 1000;
        allow delete: if false;
      }
    }

    // Documento del club: lo crea el primer miembro (marca que ya se
    // cargaron los datos iniciales); no se modifica.
    match /clubs/{clubId} {
      allow read: if esMiembro();
      allow create: if esMiembro()
        && request.resource.data.keys().hasOnly(['nombre', 'creadoEn']);
      allow update, delete: if false;
    }

    // Miembros: cada quien ve y crea solo su propio registro.
    match /usuarios/{uid} {
      allow get: if conGoogle() && request.auth.uid == uid;
      allow create: if conGoogle()
        && request.auth.uid == uid
        && config().get('registroAbierto', true) == true
        && request.resource.data.keys().hasOnly(['nombre', 'correo', 'creadoEn']);
      allow update, delete: if false;
    }

    // Listas: solo miembros y solo si la lista está visible.
    match /clubs/{clubId}/{lista}/{itemId} {
      allow read, delete: if esMiembro() && listaVisible(lista);
      allow create, update: if esMiembro()
        && listaVisible(lista)
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 200
        // Quien agrega solo puede ponerse a sí mismo como autor.
        && (request.method == 'update'
            || !('creadoPor' in request.resource.data)
            || request.resource.data.creadoPor.uid == request.auth.uid);

      // Fotos de recuerdos dentro de Firestore (JPEG comprimido < 900 KB).
      match /fotos/{fotoId} {
        allow read, delete: if esMiembro() && listaVisible(lista);
        allow create: if esMiembro()
          && listaVisible(lista)
          && config().get('fotos', true) == true
          && request.resource.data.datos is bytes
          && request.resource.data.datos.size() <= 921600;
        allow update: if false;
      }
    }
  }
}
